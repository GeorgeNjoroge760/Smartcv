{
  "name": "smartcv-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cd server && npm install && node index.js",
    "server:install": "cd server && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:setup": "node server/db/setup.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "html2pdf.js": "^0.14.0"
  }
}
